# Optional keys. Copy this file to .env and fill in only what you have; everything works without them.
# .env is in .gitignore: never commit real keys.

# AI explanation of a case (Claude). Daily spend cap: config/live.yaml
ANTHROPIC_API_KEY=

# Extra discovery sources
URLSCAN_API_KEY=
ABUSECH_AUTH_KEY=
TAVILY_API_KEY=

# Higher CertSpotter limits (works keyless)
CERTSPOTTER_API_KEY=

# Contact email sent in the User-Agent to the Geomys certificate logs (their operator asks for it)
CT_CONTACT_EMAIL=
